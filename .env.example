# --- LLM: anthropic | ollama | openai-compatible | stub ---
# Por defecto: openai-compatible con Groq (plan gratis). Producción recomendada: anthropic (claude-haiku-5-5).
LLM_PROVIDER=openai-compatible

# --- openai-compatible (Groq u otro servidor con API tipo OpenAI) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
# Si LLM_API_KEY está vacía y LLM_BASE_URL es api.groq.com, se usa GROQ_API_KEY.
LLM_API_KEY=
GROQ_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=600
LLM_TIMEOUT_MS=30000
# Solo modelos de razonamiento (p. ej. openai/gpt-oss-120b): low | medium | high
# LLM_REASONING_EFFORT=low

# --- stub (LLM_PROVIDER=stub): respuestas fijas SOLO para pruebas; no arranca si TEST_MODE=false ---
# Regex (sin mayúsculas) que hace que el stub simule transferir_a_humano (fuera del primer mensaje).
STUB_HANDOFF_PATTERN=prueba handoff

# --- Claude (LLM_PROVIDER=anthropic, opción de producción) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Ollama (LLM_PROVIDER=ollama; opcional, solo con hardware potente: GPU con 12+ GB de VRAM) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=granite4.1:3b
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT_MS=300000
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=300

# --- Negocio ---
BUSINESS_NAME=Mi Negocio

# --- Modo prueba: solo responde a TEST_NUMBERS (separados por coma, con código de país, sin +) ---
TEST_MODE=true
TEST_NUMBERS=584121234567

# --- Panel (127.0.0.1) ---
# Mínimo 12 caracteres. Genera uno con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PANEL_TOKEN=
PORT=3000

# --- Comportamiento ---
DEBOUNCE_MS=4000
HANDOFF_PAUSE_HOURS=12
MAX_REPLIES_PER_HOUR=20
NOTIFY_OWNER=true

# Nivel de log: trace | debug | info | warn | error
LOG_LEVEL=info
